rules_version = '2';

// Firestore Rules — PanaviBunga Store (project: panavibunga-store)
// Ini adalah rules untuk project Firebase BARU, TERPISAH total dari
// project Firebase Aliftzy Store lama. Deploy manual ke Firebase Console
// / `firebase deploy --only firestore:rules` pada project panavibunga-store
// SAJA — jangan pernah deploy file ini ke project Firebase lama.
//
// Admin PanaviBunga Store: alasky200@gmail.com (sudah diisi di bawah, fungsi
// isAdmin()). Kalau suatu saat perlu ganti admin, cukup ubah email di
// baris isAdmin() di bawah ini.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "alasky200@gmail.com";
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userIdField) {
      return isLoggedIn() && request.auth.uid == userIdField;
    }

    match /settings/adminConfig {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /songs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // "stock" berisi kredensial akun (email/password/loginUrl) — TIDAK
    // pernah dibaca langsung oleh client biasa. Store membaca angka
    // agregat tersedia/total lewat api/stock-availability.js (Admin SDK
    // di server), bukan lewat rule ini.
    match /stock/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {

      allow read: if isAdmin() || isOwner(resource.data.userId);

      // Customer hanya boleh membuat order dengan status PENDING —
      // tidak pernah bisa langsung membuat order PAID (lihat requirement
      // "Payment Flow" di project ini: status hanya berubah lewat admin
      // setelah verifikasi manual bukti pembayaran).
      allow create: if isLoggedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == "PENDING";

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // otpSessions TIDAK memiliki rule di sini secara sengaja — default-deny
    // di bawah berlaku untuknya. Collection ini hanya pernah diakses lewat
    // Firebase Admin SDK di api/auth/*.js (server-side), tidak pernah
    // langsung dari client.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
